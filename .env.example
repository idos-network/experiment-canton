# Browser app
VITE_CANTON_BRIDGE_URL=http://127.0.0.1:8787

# Local bridge
CANTON_BRIDGE_PORT=8787

# Use `localnet` to target the documented Docker-based LocalNet defaults.
# Use `devnet` or `custom` when you have your own validator endpoint and auth.
CANTON_NETWORK=localnet

# Required when CANTON_NETWORK=devnet or CANTON_NETWORK=custom
# CANTON_LEDGER_CLIENT_URL=https://your-validator-ledger-api.example.com/
# CANTON_AUTH_ISSUER=your-issuer
# CANTON_AUTH_AUDIENCE=https://canton.network.global
# CANTON_AUTH_SCOPE=
# CANTON_AUTH_CLIENT_ID=ledger-api-user
# CANTON_AUTH_CLIENT_SECRET=replace-me
